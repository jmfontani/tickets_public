# ─────────────────────────────────────────────────────────────────────────────
# Configuración del pipeline de tickets
#
# Copia este fichero a `.env` y elige un perfil. NINGUNO es obligatorio de pago:
# el proyecto funciona completo con modelos locales, sin cuenta de ningún tipo.
#
#   PERFIL A · local (recomendado para empezar; sin cuenta, sin coste)
#       OCR_MODE=local
#       CLASSIFY_MODE=local
#
#   PERFIL B · Ollama Cloud, modelos del plan gratuito
#       OCR_MODE=cloud
#       CLASSIFY_MODE=cloud
#       OLLAMA_API_KEY=tu-api-key
#       TICKET_OCR_MODEL=<modelo de visión incluido en el plan gratuito>
#       TICKET_CLASSIFY_MODEL=<modelo de texto incluido en el plan gratuito>
#     La lista de modelos incluidos cambia con el tiempo: si recibes un
#     HTTP 402, el mensaje de error de Ollama dice qué modelo usar en su lugar.
#
#   PERFIL C · Ollama Cloud con suscripción o créditos
#       igual que B, con el modelo que quieras de los que dé acceso tu plan.
#
# Todo lo que va aquí es opcional salvo lo marcado; los valores por defecto
# del código ya son el perfil A.
# ─────────────────────────────────────────────────────────────────────────────

# ── OCR de fotos de ticket ───────────────────────────────────────────────────
# local  → usa el Ollama de tu máquina (sin cuenta)
# cloud  → usa la API de Ollama Cloud (necesita OLLAMA_API_KEY)
OCR_MODE=local

# Modelo local de visión (OCR_MODE=local). Debe estar descargado: `ollama pull`
LOCAL_OCR_MODEL=minicpm-v4.5:8b

# Modelo cloud de visión (OCR_MODE=cloud)
TICKET_OCR_MODEL=glm-5.3-flash

# ── Clasificación de productos en categorías ────────────────────────────────
# local  → Ollama de tu máquina (sin cuenta)
# cloud  → API de Ollama Cloud (necesita OLLAMA_API_KEY)
CLASSIFY_MODE=local

# Modelo local de texto (CLASSIFY_MODE=local)
LOCAL_CLASSIFY_MODEL=qwen2.5:7b

# Modelo cloud de texto (CLASSIFY_MODE=cloud)
TICKET_CLASSIFY_MODEL=deepseek-v4.1-flash

# ── Ollama ──────────────────────────────────────────────────────────────────
# Ollama local visto desde dentro del contenedor
LOCAL_OLLAMA_URL=http://host.docker.internal:11434

# API de Ollama Cloud (compatible con OpenAI). Solo si usas modo cloud.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=

# ── Ajustes de OCR ──────────────────────────────────────────────────────────
# El modo local es mucho más lento: dale margen.
OCR_TIMEOUT=600
OCR_MAX_TOKENS=4000
OCR_NUM_CTX=8192

# Reducción de la imagen antes de enviarla al modelo (pesa menos y abarata el
# envío). Se recorta por píxeles conservando el ancho. 0 = no reducir.
OCR_MAX_IMAGE_PIXELS=2500000
# Ancho mínimo al reducir: por debajo de esto el texto de un ticket estrecho se
# vuelve ilegible.
OCR_MIN_IMAGE_WIDTH=900
# Calidad del JPEG resultante (88 mantiene el texto limpio).
OCR_JPEG_QUALITY=88
